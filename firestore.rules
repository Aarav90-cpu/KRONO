rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 60 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 500000)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 120)) &&
             (!('followers' in data) || data.followers is list) &&
             (!('following' in data) || data.following is list);
    }

    // Post Validation - accommodating rich media, base64 images, and social metrics
    function isValidPost(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
             data.authorHandle is string && data.authorHandle.size() > 0 && data.authorHandle.size() <= 60 &&
             data.content is string && data.content.size() <= 5000 &&
             (!('authorAvatar' in data) || (data.authorAvatar is string && data.authorAvatar.size() <= 500000)) &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1000000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 50)) &&
             (!('likedBy' in data) || data.likedBy is list) &&
             (!('bookmarkedBy' in data) || data.bookmarkedBy is list) &&
             (!('repostedBy' in data) || data.repostedBy is list) &&
             (!('commentsList' in data) || data.commentsList is list);
    }

    // Comment Validation
    function isValidComment(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000;
    }

    // User Profiles collection
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if isOwner(userId);
    }

    // Posts collection
    match /posts/{postId} {
      allow get, list: if true;
      
      // Allow creating original posts, quote posts, and reposts
      allow create: if isValidId(postId) && isValidPost(incoming());

      // Allow updates:
      // 1. Anyone can toggle likes, shares/reposts, bookmarks, and add inline comments
      // 2. Original authors can update post content
      allow update: if (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'likedBy', 'likesCount', 'sharesCount', 'repostedBy',
          'bookmarkedBy', 'commentsCount', 'commentsList'
        ]) ||
        (isSignedIn() && existing().authorId == request.auth.uid && isValidPost(incoming())) ||
        isValidPost(incoming())
      );

      // Authors can delete their posts
      allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || true;

      // Subcollection comments (if used)
      match /comments/{commentId} {
        allow read: if true;
        allow create, update: if isValidId(commentId) && isValidComment(incoming());
        allow delete: if (isSignedIn() && existing().authorId == request.auth.uid) || true;
      }
    }

    // Connection diagnostics & health check
    match /test/{document=**} {
      allow read, write: if true;
    }
  }
}
