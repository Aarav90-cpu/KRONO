rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global deny-by-default fallback
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 50 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 1000)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 280)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 100)) &&
             (!('followers' in data) || (data.followers is list && data.followers.size() <= 5000)) &&
             (!('following' in data) || (data.following is list && data.following.size() <= 5000));
    }

    // Post Validation
    function isValidPost(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 80 &&
             data.authorHandle is string && data.authorHandle.size() > 0 && data.authorHandle.size() <= 50 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             (!('mediaUrl' in data) || (data.mediaUrl is string && data.mediaUrl.size() <= 1000)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('likedBy' in data) || (data.likedBy is list && data.likedBy.size() <= 10000)) &&
             (!('bookmarkedBy' in data) || (data.bookmarkedBy is list && data.bookmarkedBy.size() <= 10000)) &&
             (!('repostedBy' in data) || (data.repostedBy is list && data.repostedBy.size() <= 10000));
    }

    // Comment Validation
    function isValidComment(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.postId is string && data.postId.size() > 0 && data.postId.size() <= 128 &&
             data.authorId is string && data.authorId.size() > 0 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 80 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 1000;
    }

    // User Profiles collection
    match /users/{userId} {
      allow get: if true;
      allow list: if true;
      allow create: if isOwner(userId) && isValidId(userId) && incoming().uid == request.auth.uid && isValidUserProfile(incoming());
      allow update: if (isOwner(userId) && incoming().uid == existing().uid && isValidUserProfile(incoming())) ||
                       (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['followers']));
      allow delete: if isOwner(userId);
    }

    // Posts collection
    match /posts/{postId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidId(postId) && incoming().authorId == request.auth.uid && isValidPost(incoming());
      allow update: if (
        // Author full update (content, tags, etc.)
        (isSignedIn() && existing().authorId == request.auth.uid && incoming().authorId == existing().authorId && isValidPost(incoming())) ||
        // Other authenticated users toggling social interactions (likes, shares, reposts, bookmarks, comments count)
        (isSignedIn() && isValidPost(incoming()) && incoming().authorId == existing().authorId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likesCount', 'sharesCount', 'repostedBy', 'bookmarkedBy', 'commentsCount', 'commentsList']))
      );
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;

      // Subcollection comments
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(commentId) && incoming().authorId == request.auth.uid && isValidComment(incoming());
        allow update: if isSignedIn() && existing().authorId == request.auth.uid && incoming().authorId == existing().authorId && isValidComment(incoming());
        allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
      }
    }

    // Health check test connection path for connection diagnostics
    match /test/connection {
      allow read: if true;
    }
  }
}
